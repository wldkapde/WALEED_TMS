@{
    Layout = "~/Views/Shared/MainTMSLayout.cshtml";
}
@Html.AntiForgeryToken()
@model List<WALEED_TMS.Models.UserModel>

<h2 style="text-align: center; font-size: 24px; font-weight: bold; color: #333;">Manage Users</h2>

<table class="user-table">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>DOB</th>
            <th>Email</th>
            <th>Hear About Us</th>
            <th>Preferred Contact</th>
            <th>Created Date</th>
            <th>Is Active</th>
            <th>Edit User</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.FullName</td>
                <td>@(user.DOB.HasValue ? user.DOB.Value.ToString("dd-MM-yyyy") : "N/A")</td>
                <td>@user.Email</td>
                <td>@user.HearAboutUs</td>
                <td>@user.PreferredContact</td>
                <td>@(user.CreatedDate.HasValue ? user.CreatedDate.Value.ToString("dd-MM-yyyy") : "N/A")</td>
                <td>
                    <label class="switch">
                        <input type="checkbox" class="status-toggle"
                               data-userid="@user.UserID"
                               @(user.IsActive == "Y" ? "checked" : "")>
                        <span class="slider round"></span>
                    </label>
                </td>
                <td>
                    <a href="@Url.Action("EditUser", "ClientAndAdmin", new { userId = user.UserID })"
                       class="btn btncolor">Edit User Data</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@*<script src="~/Scripts/jquery-3.3.1.min.js"></script>*@
@section Scripts {
    <script>
$(document).ready(function() {
    $('.status-toggle').change(function() {
        var toggle = $(this);
        var userId = toggle.data('userid');
        var isActive = toggle.is(':checked');

        console.log('Toggle changed - UserID:', userId, 'Status:', isActive);

        $.ajax({
            url: '@Url.Action("UpdateUserStatus", "ClientAndAdmin")',
            type: 'POST',
            data: { userId: userId, isActive: isActive },
            success: function(response) {
                console.log('Server response:', response);
                if (!response.success) {
                    alert('Failed to update status');
                    toggle.prop('checked', !isActive);
                }
            },
            error: function(xhr, status, error) {
                console.error('AJAX Error:', error);
                alert('An error occurred while updating status');
                toggle.prop('checked', !isActive);
            }
        });
    });
});
    </script>
}

<style>
    .btncolor {
        background: linear-gradient(to right, #cc2b5e, #753a88);
        color: white;
    }

    .user-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
        background: white;
        box-shadow: 0px 0px 10px #ccc;
        border-radius: 8px;
        overflow: hidden;
    }

        .user-table th, .user-table td {
            border: 1px solid #ddd;
            padding: 10px;
            text-align: center;
        }

    thead {
        background: linear-gradient(to right, #cc2b5e, #753a88);
    }

    .user-table th {
        color: white;
        font-weight: bold;
    }

    .switch {
        position: relative;
        display: inline-block;
        width: 60px;
        height: 34px;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        transition: .4s;
    }

        .slider:before {
            position: absolute;
            content: "";
            height: 26px;
            width: 26px;
            left: 4px;
            bottom: 4px;
            background-color: white;
            transition: .4s;
        }

    input:checked + .slider {
        background: linear-gradient(to right, #cc2b5e, #753a88);
    }

    input:focus + .slider {
        box-shadow: 0 0 1px #2196F3;
    }

    input:checked + .slider:before {
        transform: translateX(26px);
    }

    .slider.round {
        border-radius: 34px;
    }

        .slider.round:before {
            border-radius: 50%;
        }
</style>
}
