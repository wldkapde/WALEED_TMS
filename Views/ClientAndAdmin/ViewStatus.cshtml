@model List<WALEED_TMS.Models.TourBookingModel>

@{
    ViewBag.Title = "View Status";
    Layout = "~/Views/Shared/MainTMSLayout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<style>
    /* Table Styling */
    .table {
        border-radius: 10px;
        overflow: hidden;
    }

        .table tbody tr:hover {
            background-color: #f8f9fa;
        }

    /* Status Badges */
    .badge {
        padding: 8px 12px;
        font-size: 14px;
    }
    .bgcolortbl th {
        background: linear-gradient(to right, #cc2b5e, #753a88) !important;
        color: white !important;
    }


</style>
<body>
    <div class="container mt-4">
        <h2 class="mb-3 text-center">Tour Booking Details</h2>

        @if (Model != null && Model.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-bordered table-striped text-center align-middle shadow">
                    <thead class="bgcolortbl">
                        <tr>
                            <th>Tour Location</th>
                            <th>From Date</th>
                            <th>End Date</th>
                            <th>Adults</th>
                            <th>Children</th>
                            <th>Estimate ($)</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tour in Model)
                        {
                            <tr>
                                <td>@tour.TourLocation</td>
                                <td>@tour.TourStartDate.ToString("yyyy-MM-dd")</td>
                                <td>@tour.TourEndDate.ToString("yyyy-MM-dd")</td>
                                <td>@tour.Adults</td>
                                <td>@tour.Children</td>
                                <td>$@tour.Estimate</td>
                                <td>
                                    <span class="badge
                                        @(tour.TourStatus == "Confirmed" ? "bg-success" :
                                          tour.TourStatus == "Pending" ? "bg-warning text-dark" : "bg-danger")">
                                        @tour.TourStatus
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-center text-danger fs-5">No tour details found.</p>
        }
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
