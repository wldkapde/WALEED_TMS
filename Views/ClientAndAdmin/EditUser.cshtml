@model WALEED_TMS.Models.UserModel
@{
    ViewBag.Title = "Edit User";
    Layout = "~/Views/Shared/MainTMSLayout.cshtml";
}

<div class="container" style="background-color: #f4f4f4; padding: 20px;">
    <h2>Edit User</h2>

    @using (Html.BeginForm())
    {
        @Html.HiddenFor(model => model.UserID)

        <div class="form-group">
            @Html.LabelFor(model => model.FullName)
            @Html.TextBoxFor(model => model.FullName, new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.DOB)
            @Html.TextBoxFor(model => model.DOB, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Email)
            @Html.TextBoxFor(model => model.Email, new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.HearAboutUs)
            @Html.DropDownListFor(model => model.HearAboutUs,
                new SelectList(ViewBag.HearAboutUsOptions, Model?.HearAboutUs ?? string.Empty),
                new { @class = "form-control" }) <!-- "Select Option" Removed -->
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.PreferredContact)
            @Html.DropDownListFor(model => model.PreferredContact,
                new SelectList(ViewBag.PreferredContactOptions, Model?.PreferredContact ?? string.Empty),
                new { @class = "form-control" }) <!-- "Select Option" Removed -->
        </div>


        <button type="submit" class="btn btn-primary">Update</button>
        <a href="@Url.Action("ManageUsers")" class="btn btn-default">Cancel</a>
    }
</div>