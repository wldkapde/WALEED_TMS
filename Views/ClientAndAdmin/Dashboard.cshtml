@* -----------------------------------------DUBaI TRIP-------------------------------------------------------- *@
<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <div class="tour-card shadow">
                <div class="responsive">
                    <div class="gallery">
                        <img src="~/Content/IMAGES/DUBAI_TRIP.jpg" alt="DUBAI" width="600" height="400" style="padding-bottom: 3px;">
                        <img src="~/Content/IMAGES/DUBAI_TRIP.jpg" alt="DUBAI" width="600" height="400" style="padding-bottom: 3px;">
                        <img src="~/Content/IMAGES/DUBAI_TRIP.jpg" alt="DUBAI" width="600" height="400" style="padding-bottom: 3px;">
                        <div class="desc">7-Day Dubai Tour</div>
                    </div>
                </div>

                <div class="tour-overview">
                    <h4><b>7-Day Dubai Tour</b></h4>
                    <p>
                        Explore the wonders of Dubai with our 7-day tour package. Enjoy the modern marvels, cultural experiences, and thrilling activities that Dubai has to offer.
                    </p>
                    <h5><b>Itinerary</b></h5>
                    <ul>
                        <li><strong>Day 1:</strong> Arrival in Dubai, transfer to hotel, evening at leisure.</li>
                        <li><strong>Day 2:</strong> City Tour (Burj Khalifa, Dubai Mall, Dubai Fountain, Jumeirah Mosque, Dubai Museum), lunch at a local restaurant, visit Jumeirah Beach, Dhow Cruise Dinner.</li>
                        <li><strong>Day 3:</strong> Free time, Desert Safari with dune bashing, camel riding, sandboarding, BBQ Dinner in the desert camp.</li>
                        <li><strong>Day 4:</strong> Visit to Miracle Garden, Global Village, and Dubai Marina.</li>
                        <li><strong>Day 5:</strong> Abu Dhabi City Tour (Sheikh Zayed Grand Mosque, Ferrari World, Yas Island).</li>
                        <li><strong>Day 6:</strong> Free day for shopping or optional tours (Ski Dubai, IMG Worlds of Adventure).</li>
                        <li><strong>Day 7:</strong> Departure from Dubai, transfer to the airport.</li>
                    </ul>
                    <h5><b>Inclusions</b></h5>
                    <ul>
                        <li>6 nights accommodation in a 4-star hotel</li>
                        <li>Daily breakfast and dinner</li>
                        <li>All transfers and sightseeing tours as per itinerary</li>
                        <li>Desert Safari with BBQ Dinner</li>
                        <li>Dhow Cruise Dinner</li>
                        <li>Entry fees to attractions as mentioned</li>
                    </ul>
                    <h5><b>Price</b></h5>
                    <p>Approx. $1200 per adult and $900 for children (below age of 18 years). (based on double occupancy)</p>
                </div>
                <div class="tour-button">
                    <button type="button" class="btn btn-primary" id="btn" data-toggle="modal" data-target="#DubaiTour">
                        Book Tour
                    </button>
                </div>
                <!------------------ Modal ------------------------------>
                <div class="modal fade" id="DubaiTour" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content">
                            <div class="modal-header" id="ModalHeader">
                                <h5 class="modal-title" id="exampleModalLabel">Book Dubai Tour</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true" id="ModalCloseBtn">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                <form id="dubaiTourForm">
                                    <p id="extraChargeNoticeDubai"></p>
                                    <div class="form-group">
                                        <label for="fromDateDubai">From Date</label>
                                        <input type="date" class="form-control" id="fromDateDubai" required onchange="setMinToDateDubai()">
                                    </div>
                                    <div class="form-group">
                                        <label for="toDateDubai">To Date</label>
                                        <input type="date" class="form-control" id="toDateDubai" required onchange="calculateEstimateForDubai()">
                                    </div>
                                    <div class="form-group">
                                        <label for="adultsDubai">Adults</label>
                                        <input type="number" class="form-control" id="adultsforDubai" min="1" value="1" required oninput="calculateEstimateForDubai()">
                                    </div>
                                    <div class="form-group">
                                        <label for="childrenDubai">Children (below the age of 10)</label>
                                        <input type="number" class="form-control" id="childrenforDubai" min="0" value="0" required oninput="calculateEstimateForDubai()">
                                    </div>
                                    <div class="form-group">
                                        <label for="totalEstimateDubai">Total Estimate ($)</label>
                                        <input type="text" class="form-control" id="totalEstimateforDubai" disabled>
                                    </div>
                                </form>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                                <button type="button" class="btn btn-primary" id="bookTourBtn">Book Tour</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Thank you Modal -->
                <div class="modal fade" id="thankYouModal" tabindex="-1" role="dialog" aria-labelledby="thankYouModalLabel" aria-hidden="true">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content" >
                            <div class="modal-header" id="thankUModalHeader">
                                <h5 class="modal-title" id="thankYouModalLabel">Thank You!</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                <p>Thank you for booking. Your application has been submitted.</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
