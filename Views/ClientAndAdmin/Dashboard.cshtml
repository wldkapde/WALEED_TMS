@* ------------------------SCRIPTS ONLY----------------------------------- *@
<script>

    //--------------------DUBAI
   document.getElementById('bookTourBtn').addEventListener('click', function () {
    const fromDate = document.getElementById('fromDateDubai').value;
    const toDate = document.getElementById('toDateDubai').value;
    const adults = parseInt(document.getElementById('adultsforDubai').value) || 0;
    const children = parseInt(document.getElementById('childrenforDubai').value) || 0;
    const estimate = parseFloat(document.getElementById('totalEstimateforDubai').value) || 0;
    const userID = localStorage.getItem("UserID");
    const tourLocation = "Dubai"; // ✅ FIXED: TourLocation is now "Dubai"

    if (!userID || userID === "null") {
        alert("User not logged in. Please log in to continue.");
        return;
    }

    if (!fromDate || !toDate || isNaN(adults) || isNaN(children) || isNaN(estimate)) {
        alert("Please fill all required fields.");
        return;
    }

    const formData = new URLSearchParams();
    formData.append("UserID", userID);
    formData.append("TourLocation", tourLocation); // ✅ Fixed: Always sending "Dubai"
    formData.append("TourStartDate", fromDate);
    formData.append("TourEndDate", toDate);
    formData.append("Adults", adults);
    formData.append("Children", children);
    formData.append("Estimate", estimate);

    fetch('/Tour/BookTour', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            $('#DubaiTour').modal('hide');
            $('#thankYouModal').modal('show'); // ✅ Show Thank You Modal on Success
        } else {
            alert("Booking failed: " + data.message);
        }
    })
    .catch(error => {
        console.error("Error:", error);
        alert("Something went wrong. Please try again.");
    });
});

    // 🔹 Function to set minimum 'To Date' based on 'From Date'
    function setMinToDateDubai() {
        const fromDate = document.getElementById('fromDateDubai').value;
        document.getElementById('toDateDubai').setAttribute('min', fromDate);
        calculateEstimateForDubai();
    }

    // 🔹 Function to calculate total estimated cost
    function calculateEstimateForDubai() {
        const fromDate = new Date(document.getElementById('fromDateDubai').value);
        const toDate = new Date(document.getElementById('toDateDubai').value);
        const adults = parseInt(document.getElementById('adultsforDubai').value) || 0;
        const children = parseInt(document.getElementById('childrenforDubai').value) || 0;

        const baseAdultPrice = 1200;
        const baseChildPrice = 900;
        const extensionAdultPrice = 100;
        const extensionChildPrice = 70;

        if (fromDate && toDate && toDate >= fromDate) {
            const days = Math.ceil((toDate - fromDate) / (1000 * 60 * 60 * 24));
            const baseDays = 7;
            const extraDays = days > baseDays ? days - baseDays : 0;

            const totalAdultPrice = (baseAdultPrice + (extraDays * extensionAdultPrice)) * adults;
            const totalChildPrice = (baseChildPrice + (extraDays * extensionChildPrice)) * children;
            const totalPrice = totalAdultPrice + totalChildPrice;

            document.getElementById('totalEstimateforDubai').value = totalPrice.toFixed(2);
            document.getElementById('extraChargeNoticeDubai').innerText =
                extraDays > 0
                    ? `Note: For stays longer than 7 days, an additional $100 per day for adults and $70 per day for children will be applied.`
                    : '';
        }
    }



    //------------------------SINGAPORE

        document.getElementById('btnSingaporeBookTour').addEventListener('click', function () {
    const fromDate = document.getElementById('fromDateSingapore').value;
        const toDate = document.getElementById('toDateSingapore').value;
        const adults = parseInt(document.getElementById('adultsforSingapore').value) || 0;
        const children = parseInt(document.getElementById('childrenforSingapore').value) || 0;
        const estimate = parseFloat(document.getElementById('totalEstimateforSingapore').value) || 0;
        const userID = localStorage.getItem("UserID");
        const tourLocation = "Singapore"; // ✅ FIXED: TourLocation is now "Singapore"

        if (!userID || userID === "null") {
            alert("User not logged in. Please log in to continue.");
        return;
    }

        if (!fromDate || !toDate || isNaN(adults) || isNaN(children) || isNaN(estimate) || estimate === 0) {
            alert("Please fill all required fields.");
        return;
    }

        const formData = new URLSearchParams();
        formData.append("UserID", userID);
        formData.append("TourLocation", tourLocation);
        formData.append("TourStartDate", fromDate);
        formData.append("TourEndDate", toDate);
        formData.append("Adults", adults);
        formData.append("Children", children);
        formData.append("Estimate", estimate);

        console.log("Booking Request Data:", formData.toString()); // ✅ Debugging

