    <!-- Rental Modal -->
    <div class="modal fade" id="rentalModal" tabindex="-1" role="dialog" aria-labelledby="rentalModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="rentalModalLabel">Rent a Car</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form id="rentalForm">
                        <input type="hidden" id="carId" name="carId">
                        <input type="hidden" id="carName" name="carName">
                        <div class="form-group">
                            <label for="fromDate">From Date:</label>
                            <input type="date" class="form-control" id="fromDate" name="fromDate" required>
                        </div>
                        <div class="form-group">
                            <label for="toDate">To Date:</label>
                            <input type="date" class="form-control" id="toDate" name="toDate" required>
                        </div>
                        <div class="form-group">
                            <label for="passengers">Number of Passengers</label>
                            <input type="number" class="form-control" id="passengers" name="passengers" placeholder="Number of Passengers" required>
                        </div>
                        <div class="form-group">
                            <label for="pickupLocation">Pickup Location</label>
                            <input type="text" class="form-control" id="pickupLocation" name="pickupLocation" placeholder="Enter Pickup location" required>
                        </div>
                        <div class="form-group">
                            <label for="dropLocation">Drop Location</label>
                            <input type="text" class="form-control" id="dropLocation" name="dropLocation" placeholder="Enter Drop location" required>
                        </div>
                        <div class="form-group">
                            <label for="rentalPrice">Total Price:</label>
                            <input type="text" class="form-control" id="rentalPrice" name="rentalPrice" readonly>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn" id="submitRental">Book Now</button>
                </div>
            </div>
        </div>
    </div>

</div>
    @section scripts {
        <script>
            $(document).ready(function () {
                let rentalPrice = 0;
                let stopsCount = 0;
                let carId = 0;
                const stopCharge = 250;

                $('#rentalModal').on('show.bs.modal', function (event) {
                    let button = $(event.relatedTarget);
                    rentalPrice = parseInt(button.data('price')) || 0;
                    carId = parseInt(button.data('car-id')) || 0;
                    $('#carId').val(carId);
                    stopsCount = 0;

                    // Reset form
                    $('#rentalForm')[0].reset();
                    $('.stops-container').html(`
                <div class="form-group">
                    <div class="input-group">
                        <input type="text" class="form-control" placeholder="Add Stop 1">
                        <div class="input-group-append">
                            <button class="btn btn-success add-stop" type="button">+</button>
                        </div>
                    </div>
                </div>
            `);

                    if ($('#stop-note').length > 0) {
                        $('#stop-note').remove();
                    }

                    updatePrice();
                });

                $('#fromDate, #toDate').on('change', function () {
                    updatePrice();
                });

                function updatePrice() {
                    let fromDate = $('#fromDate').val();
                    let toDate = $('#toDate').val();

                    if (fromDate && toDate) {
                        let start = new Date(fromDate);
                        let end = new Date(toDate);
                        let timeDiff = end - start;
                        let days = Math.ceil(timeDiff / (1000 * 60 * 60 * 24)) + 1;

                        if (days > 0) {
                            let total = rentalPrice * days + stopsCount * stopCharge;
                            $('#rentalPrice').val('₹' + total);
                        } else {
                            $('#rentalPrice').val('₹' + rentalPrice);
                        }
                    } else {
                        $('#rentalPrice').val('₹' + rentalPrice);
                    }
                }

                $(document).on('click', '.add-stop', function () {
                    stopsCount++;
                    let newStop = `
                <div class="form-group">
                    <div class="input-group">
                        <input type="text" class="form-control" placeholder="Add Stop ${stopsCount + 1}">
                        <div class="input-group-append">
                            <button class="btn btn-success add-stop" type="button">+</button>
                        </div>
                    </div>
                </div>
            `;
                    $(this).closest('.form-group').after(newStop);
                    updatePrice();
                });
            });

                // Get user's current location
                $('.use-location').on('click', function () {
                    const targetField = $(this).data('target') === 'pickup' ? $('#pickupLocation') : $('#dropLocation');

                    if (navigator.geolocation) {
                        navigator.geolocation.getCurrentPosition(
                            function (position) {
                                // Get coordinates
                                const latitude = position.coords.latitude;
                                const longitude = position.coords.longitude;

                                // Use reverse geocoding to get address
                                reverseGeocode(latitude, longitude, targetField);
                            },
                            function (error) {
                                let errorMessage = "Unable to retrieve your location. ";
                                switch (error.code) {
                                    case error.PERMISSION_DENIED:
                                        errorMessage += "User denied the request for Geolocation.";
                                        break;
                                    case error.POSITION_UNAVAILABLE:
                                        errorMessage += "Location information is unavailable.";
                                        break;
                                    case error.TIMEOUT:
                                        errorMessage += "The request to get user location timed out.";
                                        break;
                                    case error.UNKNOWN_ERROR:
                                        errorMessage += "An unknown error occurred.";
                                        break;
                                }
                                alert(errorMessage);
                            }
                        );
                    } else {
                        alert("Geolocation is not supported by this browser.");
                    }
                });

                function reverseGeocode(latitude, longitude, targetField) {
                    // Using Nominatim API for reverse geocoding (free and doesn't require API key)
                    const url = `https://nominatim.openstreetmap.org/reverse?format=json&lat=${latitude}&lon=${longitude}&zoom=18&addressdetails=1`;

                    $.ajax({
                        url: url,
                        type: "GET",
                        success: function (response) {
                            if (response && response.display_name) {
                                targetField.val(response.display_name);
                            } else {
                                targetField.val(`${latitude}, ${longitude}`);
                            }
                        },
                        error: function () {
                            // If reverse geocoding fails, just use coordinates
                            targetField.val(`${latitude}, ${longitude}`);
                        }
                    });
                }
                // Set car details when the modal is opened
                $('.btn[data-toggle="modal"]').on('click', function () {
                    const carId = $(this).data('car-id');
                    const price = $(this).data('price');
                    const carName = $(this).closest('.car-card').find('h3').text(); // Get the car name from the card

                    $('#carId').val(carId);
                    $('#carName').val(carName); // Set the car name
                    $('#rentalPrice').val('₹' + price);
                });

                // Handle rental form submission
                $('#submitRental').on('click', function () {
                    if (!$('#rentalForm')[0].checkValidity()) {
                        $('#rentalForm')[0].reportValidity();
                        return;
                    }

                    const rentalData = {
                        CarID: $('#carId').val(),
                        CarName: $('#carName').val(),
                        FromDate: $('#fromDate').val(),
                        ToDate: $('#toDate').val(),
                        NumberOfPassengers: $('#passengers').val(),
                        PickupLocation: $('#pickupLocation').val(),
                        DropLocation: $('#dropLocation').val(),
                        TotalPrice: $('#rentalPrice').val().replace('₹', '')
                    };

                    $.ajax({
                        url: '/RentalCars/BookCar',
                        type: 'POST',
                        data: rentalData,
                        success: function (response) {
                            if (response.success) {
                                alert('Booking successful!');
                                $('#rentalModal').modal('hide');
                            } else {
                                alert('Booking failed: ' + response.message);
                            }
                        },
                        error: function () {
                            alert('An error occurred while processing your request.');
                        }
                    });
                });
        </script>
    }
