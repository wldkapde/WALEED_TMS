@{
    ViewBag.Title = "Rental Cars";
    Layout = "~/Views/Shared/MainTMSLayout.cshtml";
}

<div class="container mt-4">
    <h2 class="mb-4">Rent a Car for Your Journey</h2>

    <style>
        .car-card {
            display: flex;
            align-items: center;
            padding: 20px;
            margin-bottom: 20px;
            border: 1px solid #ddd;
            border-radius: 8px;
        }

        .car-image {
            width: 200px;
            margin-right: 20px;
        }

        .car-details {
            flex-grow: 1;
        }

        .car-actions {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
        }

            .car-actions button {
                margin-bottom: 10px;
            }

        .modal-body input[type="date"] {
            width: 48%;
            display: inline-block;
        }

        .modal-body input[type="text"], .modal-body select {
            width: 100%;
            margin-bottom: 10px;
        }

        .modal-body .stops-container {
            margin-bottom: 10px;
        }

            .modal-body .stops-container input[type="text"] {
                width: 90%;
                display: inline-block;
            }

        .btn {
            background: linear-gradient(to right, #cc2b5e, #753a88);
            color: White;
        }

        

        label {
            font-weight: bold;
        }

        .modal-body .stops-container button {
            width: 8%;
            display: inline-block;
        }

        .modal-header {
            background: linear-gradient(to right, #cc2b5e, #753a88);
            color: white;
        }
    </style>

